# Everything Tome's build and tests need, so they don't depend on the host:
# the 32-bit MinGW toolchain, CMake and Ninja, Wine (unit tests, the e2e
# test), Xvfb and Mesa's software OpenGL (the game off screen, no GPU),
# Wine's ALSA driver (the game's sound to ALSA's null device, tools/test-env.sh), the
# Rust target for the Rust examples, Python and ImageMagick.
#
#   make container            build this image (tome-dev)
#   make container IMAGE_TARGET=ci   only the `ci` stage, as CI builds it
#   make container-test       unit tests inside it
#   make container-e2e        the e2e test inside it (input/ mounted read-only; GAME_VERSION passed on)
#
# Two stages: `ci` builds Tome and runs `make test` (the unit tests are
# Windows programs, so Wine is in it); the last one adds what running the
# game needs (e2e test only, never in CI: no game files there).
FROM registry.fedoraproject.org/fedora:44 AS ci

RUN dnf install -y --setopt=install_weak_deps=False \
        cmake ninja-build make git python3 procps-ng which \
        mingw32-gcc-c++ mingw64-gcc \
        wine-core wine-core.i686 wine-common wine-winefonts wine-ldap.x86_64 \
        cargo rust rust-std-static-i686-pc-windows-gnu clang llvm \
        compiler-rt \
    && dnf clean all

# Wine keeps its prefix under the build folder (tools/test-env.sh); this is
# only for wine commands run by hand.
ENV WINEDEBUG=-all
# The test scripts and their checks have UTF-8 text; the C locale breaks them.
ENV LANG=C.UTF-8
# `make test` gives this container's Wine prefix the null display driver when
# there's no display (Makefile, test).
ENV TOME_CONTAINER=1

# The game off screen: Xvfb and Mesa's software OpenGL (no GPU), Wine's ALSA
# driver (its sound to ALSA's null device, tools/test-env.sh), ImageMagick
# (screenshots).
FROM ci AS dev
RUN dnf install -y --setopt=install_weak_deps=False \
        mesa-dri-drivers mesa-dri-drivers.i686 mesa-libGL.i686 mesa-libEGL.i686 \
        xorg-x11-server-Xvfb ImageMagick \
        wine-alsa.x86_64 alsa-lib \
    && dnf clean all
