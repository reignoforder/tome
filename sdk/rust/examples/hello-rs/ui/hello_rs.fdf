// The hello-rs mod's button, created on the main menu from code. Its own
// names, so it can sit beside the C hello example's button.

IncludeFile "UI\FrameDef\Glue\StandardTemplates.fdf",

Frame "GLUETEXTBUTTON" "HelloRsButton" INHERITS WITHCHILDREN "StandardSmallButtonTemplate" {
    Width 0.12,
    Height 0.03,

    ButtonText "HelloRsButtonText",
    Frame "TEXT" "HelloRsButtonText" INHERITS "StandardButtonTextTemplate" {
        Text "Hello (Rust)",
    }
}
