{
  "$schema": "../../schemas/config.schema.schema.json",
  "type": "object",
  "properties": {
    "greeting": {
      "type": "string", "title": "Greeting", "maxLength": 32, "default": "Hello",
      "description": "What /hello and the Greet key say"
    },
    "shout": { "type": "boolean", "title": "Shout", "description": "Adds an exclamation mark", "default": false },
    "repeat": {
      "type": "integer", "title": "Repeat", "minimum": 1, "maximum": 5, "default": 1,
      "description": "How many times the greeting is shown"
    },
    "seconds": {
      "type": "number", "title": "Seconds on screen", "minimum": 1, "maximum": 10, "step": 0.5, "default": 5
    },
    "audience": {
      "type": "string", "title": "Audience", "enum": ["world", "friends", "tome"],
      "enumTitles": ["World", "Friends", "Tome"], "default": "world"
    }
  }
}
